=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Loopaas\"/><meta name=\"twitter:description\" content=\"Aplicación web para gestionar cursos, credenciales y evaluaciones\"/><meta name=\"twitter:image:type\" content=\"image/png\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"600\"/><meta name=\"twitter:image\" content=\"https://loopaas.app/twitter-image.png?2e0bc232e210f89d\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"219x219\"/><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"SoftwareApplication\",\"name\":\"Loopaas\",\"url\":\"https://loopaas.app\",\"applicationCategory\":\"EducationalApplication\",\"operatingSystem\":\"Web\",\"description\":\"Aplicación para la gestión de cursos, credenciales y evaluaciones\",\"author\":{\"@type\":\"Person\",\"name\":\"Emmanuel Norambuena\",\"url\":\"https://eanorambuena.github.io\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"USD\"}}</script><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"bg-background overflow-x-hidden text-foreground\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"pointer-events-none absolute inset-0 h-full w-full overflow-hidden\" style=\"opacity:0\"><div class=\"absolute top-0 left-0 w-screen h-screen z-40 pointer-events-none\"><div style=\"transform:translateY(-350px) rotate(-45deg);background:radial-gradient(68.54% 68.72% at 55.02% 31.46%, hsla(210, 100%, 85%, .08) 0, hsla(210, 100%, 55%, .02) 50%, hsla(210, 100%, 45%, 0) 80%);width:560px;height:1380px\" class=\"absolute top-0 left-0\"></div><div style=\"transform:rotate(-45deg) translate(5%, -50%);background:radial-gradient(50% 50% at 50% 50%, hsla(210, 100%, 85%, .06) 0, hsla(210, 100%, 55%, .02) 80%, transparent 100%);width:240px;height:1380px\" class=\"absolute top-0 left-0 origin-top-left\"></div><div style=\"transform:rotate(-45deg) translate(-180%, -70%);background:radial-gradient(50% 50% at 50% 50%, hsla(210, 100%, 85%, .04) 0, hsla(210, 100%, 45%, .02) 80%, transparent 100%);width:240px;height:1380px\" class=\"absolute top-0 left-0 origin-top-left\"></div></div><div class=\"absolute top-0 right-0 w-screen h-screen z-40 pointer-events-none\"><div style=\"transform:translateY(-350px) rotate(45deg);background:radial-gradient(68.54% 68.72% at 55.02% 31.46%, hsla(210, 100%, 85%, .08) 0, hsla(210, 100%, 55%, .02) 50%, hsla(210, 100%, 45%, 0) 80%);width:560px;height:1380px\" class=\"absolute top-0 right-0\"></div><div style=\"transform:rotate(45deg) translate(-5%, -50%);background:radial-gradient(50% 50% at 50% 50%, hsla(210, 100%, 85%, .06) 0, hsla(210, 100%, 55%, .02) 80%, transparent 100%);width:240px;height:1380px\" class=\"absolute top-0 right-0 origin-top-right\"></div><div style=\"transform:rotate(45deg) translate(180%, -70%);background:radial-gradient(50% 50% at 50% 50%, hsla(210, 100%, 85%, .04) 0, hsla(210, 100%, 45%, .02) 80%, transparent 100%);width:240px;height:1380px\" class=\"absolute top-0 right-0 origin-top-right\"></div></div></div><main class=\"min-h-screen relative w-full flex flex-col items-center\"><div class=\"inset-x-0 w-full fixed top-4 left-0 right-0 z-50\"><div class=\"relative z-[60] mx-auto hidden w-full max-w-7xl flex-row items-center justify-between self-start rounded-full bg-transparent px-4 py-2 lg:flex dark:bg-transparent\" style=\"min-width:800px\"><a class=\"relative z-20 mr-4 flex items-center space-x-2 px-2 py-1 text-sm font-normal text-black\" href=\"/\"><img src=\"https://loopaas.app/loopaas_logo_square.png\" alt=\"logo\" width=\"20\" height=\"20\"/><span class=\"font-medium text-black dark:text-white\">Loopaas</span></a><div class=\"absolute inset-0 hidden flex-1 flex-row items-center justify-center space-x-2 text-sm font-medium text-zinc-600 transition duration-200 hover:text-zinc-800 lg:flex lg:space-x-2\"></div><div class=\"flex items-center gap-4\"><a class=\"px-4 py-2 rounded-md button text-black text-sm font-bold relative cursor-pointer hover:-translate-y-0.5 transition duration-200 inline-block text-center bg-transparent shadow-none dark:text-white\" href=\"/login\">Iniciar sesión</a></div></div><div class=\"relative z-50 mx-auto flex w-full max-w-[calc(100vw-2rem)] flex-col items-center justify-between bg-transparent px-0 py-2 lg:hidden\"><div class=\"flex w-full flex-row items-center justify-between\"><a class=\"relative z-20 mr-4 flex items-center space-x-2 px-2 py-1 text-sm font-normal text-black\" href=\"/\"><img src=\"https://loopaas.app/loopaas_logo_square.png\" alt=\"logo\" width=\"20\" height=\"20\"/><span class=\"font-medium text-black dark:text-white\">Loopaas</span></a><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"tabler-icon tabler-icon-menu-2 text-black dark:text-white\"><path d=\"M4 6l16 0\"></path><path d=\"M4 12l16 0\"></path><path d=\"M4 18l16 0\"></path></svg></div></div></div><section class=\"flex-1 mt-20 w-full flex flex-col gap-5 items-center\"><section class=\"w-full mx-4 px-3 sm:px-4 flex flex-row justify-start items-center max-w-4xl mt-8\"><a class=\"flex items-center py-2 px-4 rounded-md no-underline text-foreground bg-btn-background hover:bg-btn-background-hover group text-sm w-fit\"><svg class=\"mr-2 h-4 w-4 transition-transform group-hover:-translate-x-1\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewBox=\"0 0 24 24\" width=\"24\"><polyline points=\"15 18 9 12 15 6\"></polyline></svg> <!-- -->Volver atrás</a></section><div><div class=\"min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 dark:from-gray-900 dark:to-gray-800\"><div class=\"container mx-auto px-4 py-8\"><div class=\"text-center mb-12\"><h1 class=\"text-4xl font-bold text-gray-900 dark:text-white mb-4\">Guía de Uso - <!-- -->Loopaas</h1><p class=\"text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto\">Plataforma integral para la gestión de evaluaciones y coevaluaciones en cursos universitarios</p></div><div class=\"rounded-lg border bg-card text-card-foreground shadow-sm mb-8\"><div class=\"flex flex-col space-y-1.5 p-6\"><h3 class=\"font-semibold tracking-tight flex items-center gap-2 text-2xl\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-info h-6 w-6 text-blue-600\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 16v-4\"></path><path d=\"M12 8h.01\"></path></svg>¿Qué es <!-- -->Loopaas<!-- -->?</h3></div><div class=\"p-6 pt-0 space-y-4\"><p class=\"text-gray-700 dark:text-gray-300\">Loopaas<!-- --> es una plataforma web diseñada para facilitar la gestión de evaluaciones y coevaluaciones en el contexto universitario. Permite a los profesores crear evaluaciones, gestionar estudiantes y analizar resultados de manera eficiente.</p><div class=\"grid md:grid-cols-3 gap-4 mt-6\"><div class=\"text-center p-4 bg-blue-50 dark:bg-blue-950/20 rounded-lg\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users h-8 w-8 text-blue-600 mx-auto mb-2\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"></path></svg><h3 class=\"font-semibold\">Gestión de Estudiantes</h3><p class=\"text-sm text-gray-600 dark:text-gray-400\">Subir y gestionar listas de estudiantes</p></div><div class=\"text-center p-4 bg-green-50 dark:bg-green-950/20 rounded-lg\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-text h-8 w-8 text-green-600 mx-auto mb-2\"><path d=\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"></path><path d=\"M14 2v4a2 2 0 0 0 2 2h4\"></path><path d=\"M10 9H8\"></path><path d=\"M16 13H8\"></path><path d=\"M16 17H8\"></path></svg><h3 class=\"font-semibold\">Evaluaciones</h3><p class=\"text-sm text-gray-600 dark:text-gray-400\">Crear y configurar evaluaciones personalizadas</p></div><div class=\"text-center p-4 bg-purple-50 dark:bg-purple-950/20 rounded-lg\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-bar-chart3 h-8 w-8 text-purple-600 mx-auto mb-2\"><path d=\"M3 3v18h18\"></path><path d=\"M18 17V9\"></path><path d=\"M13 17V5\"></path><path d=\"M8 17v-3\"></path></svg><h3 class=\"font-semibold\">Análisis</h3><p class=\"text-sm text-gray-600 dark:text-gray-400\">Estadísticas detalladas y detección de injusticias</p></div></div></div></div><div class=\"rounded-lg border bg-card text-card-foreground shadow-sm mb-8\"><div class=\"flex flex-col space-y-1.5 p-6\"><h3 class=\"font-semibold tracking-tight flex items-center gap-2 text-2xl\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users h-6 w-6 text-green-600\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"></path></svg>Roles de Usuario</h3></div><div class=\"p-6 pt-0 space-y-6\"><div class=\"grid md:grid-cols-2 gap-6\"><div class=\"border-l-4 border-blue-500 pl-4\"><h3 class=\"text-lg font-semibold text-blue-700 dark:text-blue-300 mb-2\">Profesor</h3><ul class=\"space-y-2 text-gray-700 dark:text-gray-300\"><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big h-4 w-4 text-green-500\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path><path d=\"m9 11 3 3L22 4\"></path></svg>Crear y gestionar cursos</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big h-4 w-4 text-green-500\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path><path d=\"m9 11 3 3L22 4\"></path></svg>Subir listas de estudiantes</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big h-4 w-4 text-green-500\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path><path d=\"m9 11 3 3L22 4\"></path></svg>Crear evaluaciones</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big h-4 w-4 text-green-500\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path><path d=\"m9 11 3 3L22 4\"></path></svg>Ver estadísticas y resultados</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big h-4 w-4 text-green-500\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path><path d=\"m9 11 3 3L22 4\"></path></svg>Gestionar otros profesores</li></ul></div><div class=\"border-l-4 border-green-500 pl-4\"><h3 class=\"text-lg font-semibold text-green-700 dark:text-green-300 mb-2\">Estudiante</h3><ul class=\"space-y-2 text-gray-700 dark:text-gray-300\"><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big h-4 w-4 text-green-500\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path><path d=\"m9 11 3 3L22 4\"></path></svg>Responder evaluaciones</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big h-4 w-4 text-green-500\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path><path d=\"m9 11 3 3L22 4\"></path></svg>Ver evaluaciones disponibles</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big h-4 w-4 text-green-500\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path><path d=\"m9 11 3 3L22 4\"></path></svg>Acceder a resultados (si están disponibles)</li></ul></div></div></div></div><div class=\"grid md:grid-cols-2 gap-8 mb-8\"><div class=\"rounded-lg border bg-card text-card-foreground shadow-sm\"><div class=\"flex flex-col space-y-1.5 p-6\"><h3 class=\"text-2xl font-semibold leading-none tracking-tight flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open h-5 w-5 text-blue-600\"><path d=\"M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z\"></path><path d=\"M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z\"></path></svg>Gestión de Cursos</h3></div><div class=\"p-6 pt-0 space-y-4\"><div class=\"space-y-3\"><div class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-plus h-5 w-5 text-green-600 mt-0.5\"><path d=\"M5 12h14\"></path><path d=\"M12 5v14\"></path></svg><div><h4 class=\"font-semibold\">Crear Curso</h4><p class=\"text-sm text-gray-600 dark:text-gray-400\">Accede a &quot;Cursos&quot; → &quot;Nuevo Curso&quot; para crear un nuevo curso con nombre, abreviatura, semestre y color personalizado.</p></div></div><div class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-settings h-5 w-5 text-blue-600 mt-0.5\"><path d=\"M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z\"></path><circle cx=\"12\" cy=\"12\" r=\"3\"></circle></svg><div><h4 class=\"font-semibold\">Configurar Curso</h4><p class=\"text-sm text-gray-600 dark:text-gray-400\">Desde la página del curso, accede a &quot;Configuración&quot; para modificar detalles del curso o eliminarlo.</p></div></div><div class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-trash2 h-5 w-5 text-red-600 mt-0.5\"><path d=\"M3 6h18\"></path><path d=\"M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6\"></path><path d=\"M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2\"></path><line x1=\"10\" x2=\"10\" y1=\"11\" y2=\"17\"></line><line x1=\"14\" x2=\"14\" y1=\"11\" y2=\"17\"></line></svg><div><h4 class=\"font-semibold\">Eliminar Curso</h4><p class=\"text-sm text-gray-600 dark:text-gray-400\">En la configuración del curso, usa &quot;Eliminar curso&quot;. El sistema verificará datos relacionados y pedirá confirmación.</p></div></div></div></div></div><div class=\"rounded-lg border bg-card text-card-foreground shadow-sm\"><div class=\"flex flex-col space-y-1.5 p-6\"><h3 class=\"text-2xl font-semibold leading-none tracking-tight flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users h-5 w-5 text-green-600\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"></path></svg>Gestión de Estudiantes</h3></div><div class=\"p-6 pt-0 space-y-4\"><div class=\"space-y-3\"><div class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-upload h-5 w-5 text-blue-600 mt-0.5\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path><polyline points=\"17 8 12 3 7 8\"></polyline><line x1=\"12\" x2=\"12\" y1=\"3\" y2=\"15\"></line></svg><div><h4 class=\"font-semibold\">Subir Estudiantes</h4><p class=\"text-sm text-gray-600 dark:text-gray-400\">En &quot;Estudiantes&quot; del curso, usa el formulario para subir una lista CSV con nombres, emails y grupos.</p></div></div><div class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-eye h-5 w-5 text-purple-600 mt-0.5\"><path d=\"M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z\"></path><circle cx=\"12\" cy=\"12\" r=\"3\"></circle></svg><div><h4 class=\"font-semibold\">Ver Estudiantes</h4><p class=\"text-sm text-gray-600 dark:text-gray-400\">La tabla muestra todos los estudiantes con opciones de filtrado por email y grupo.</p></div></div><div class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-trash2 h-5 w-5 text-red-600 mt-0.5\"><path d=\"M3 6h18\"></path><path d=\"M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6\"></path><path d=\"M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2\"></path><line x1=\"10\" x2=\"10\" y1=\"11\" y2=\"17\"></line><line x1=\"14\" x2=\"14\" y1=\"11\" y2=\"17\"></line></svg><div><h4 class=\"font-semibold\">Eliminar Estudiantes</h4><p class=\"text-sm text-gray-600 dark:text-gray-400\">Cada estudiante tiene un botón de eliminar con confirmación antes de proceder.</p></div></div></div></div></div></div><div class=\"rounded-lg border bg-card text-card-foreground shadow-sm mb-8\"><div class=\"flex flex-col space-y-1.5 p-6\"><h3 class=\"font-semibold tracking-tight flex items-center gap-2 text-2xl\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-text h-6 w-6 text-purple-600\"><path d=\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"></path><path d=\"M14 2v4a2 2 0 0 0 2 2h4\"></path><path d=\"M10 9H8\"></path><path d=\"M16 13H8\"></path><path d=\"M16 17H8\"></path></svg>Evaluaciones</h3></div><div class=\"p-6 pt-0 space-y-6\"><div class=\"grid md:grid-cols-2 gap-8\"><div><h3 class=\"text-lg font-semibold mb-4\">Crear Evaluación</h3><div class=\"space-y-3\"><div class=\"flex items-start gap-3\"><div class=\"w-6 h-6 bg-blue-600 text-white rounded-full flex items-center justify-center text-sm font-bold mt-0.5\">1</div><div><h4 class=\"font-semibold\">Información Básica</h4><p class=\"text-sm text-gray-600 dark:text-gray-400\">Define título, instrucciones y fecha límite de la evaluación.</p></div></div><div class=\"flex items-start gap-3\"><div class=\"w-6 h-6 bg-blue-600 text-white rounded-full flex items-center justify-center text-sm font-bold mt-0.5\">2</div><div><h4 class=\"font-semibold\">Configurar Preguntas</h4><p class=\"text-sm text-gray-600 dark:text-gray-400\">Agrega preguntas de texto, opción múltiple, escala Likert, etc.</p></div></div><div class=\"flex items-start gap-3\"><div class=\"w-6 h-6 bg-blue-600 text-white rounded-full flex items-center justify-center text-sm font-bold mt-0.5\">3</div><div><h4 class=\"font-semibold\">Publicar</h4><p class=\"text-sm text-gray-600 dark:text-gray-400\">La evaluación estará disponible para que los estudiantes respondan.</p></div></div></div></div><div><h3 class=\"text-lg font-semibold mb-4\">Tipos de Preguntas</h3><div class=\"space-y-2\"><div class=\"flex items-center gap-2\"><div class=\"inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 text-foreground\">Texto</div><span class=\"text-sm text-gray-600 dark:text-gray-400\">Respuestas de texto libre</span></div><div class=\"flex items-center gap-2\"><div class=\"inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 text-foreground\">Opción Múltiple</div><span class=\"text-sm text-gray-600 dark:text-gray-400\">Selección de una opción</span></div><div class=\"flex items-center gap-2\"><div class=\"inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 text-foreground\">Checkbox</div><span class=\"text-sm text-gray-600 dark:text-gray-400\">Selección múltiple</span></div><div class=\"flex items-center gap-2\"><div class=\"inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 text-foreground\">Escala Likert</div><span class=\"text-sm text-gray-600 dark:text-gray-400\">Evaluación por criterios</span></div></div></div></div></div></div><div class=\"rounded-lg border bg-card text-card-foreground shadow-sm mb-8\"><div class=\"flex flex-col space-y-1.5 p-6\"><h3 class=\"font-semibold tracking-tight flex items-center gap-2 text-2xl\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-bar-chart3 h-6 w-6 text-indigo-600\"><path d=\"M3 3v18h18\"></path><path d=\"M18 17V9\"></path><path d=\"M13 17V5\"></path><path d=\"M8 17v-3\"></path></svg>Estadísticas y Análisis</h3></div><div class=\"p-6 pt-0 space-y-6\"><div class=\"grid md:grid-cols-2 gap-8\"><div><h3 class=\"text-lg font-semibold mb-4\">Estadísticas Generales</h3><ul class=\"space-y-2 text-gray-700 dark:text-gray-300\"><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big h-4 w-4 text-green-500\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path><path d=\"m9 11 3 3L22 4\"></path></svg>Total de respuestas</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big h-4 w-4 text-green-500\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path><path d=\"m9 11 3 3L22 4\"></path></svg>Tasa de participación</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big h-4 w-4 text-green-500\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path><path d=\"m9 11 3 3L22 4\"></path></svg>Distribución temporal</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big h-4 w-4 text-green-500\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path><path d=\"m9 11 3 3L22 4\"></path></svg>Estadísticas por grupo</li></ul></div><div><h3 class=\"text-lg font-semibold mb-4\">Detección de Injusticias</h3><div class=\"space-y-3\"><div class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-triangle-alert h-5 w-5 text-orange-600 mt-0.5\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"></path><path d=\"M12 9v4\"></path><path d=\"M12 17h.01\"></path></svg><div><h4 class=\"font-semibold\">Análisis Automático</h4><p class=\"text-sm text-gray-600 dark:text-gray-400\">El sistema detecta automáticamente grupos con promedios negativos en coevaluaciones.</p></div></div><div class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-share2 h-5 w-5 text-blue-600 mt-0.5\"><circle cx=\"18\" cy=\"5\" r=\"3\"></circle><circle cx=\"6\" cy=\"12\" r=\"3\"></circle><circle cx=\"18\" cy=\"19\" r=\"3\"></circle><line x1=\"8.59\" x2=\"15.42\" y1=\"13.51\" y2=\"17.49\"></line><line x1=\"15.41\" x2=\"8.59\" y1=\"6.51\" y2=\"10.49\"></line></svg><div><h4 class=\"font-semibold\">Compartir Estadísticas</h4><p class=\"text-sm text-gray-600 dark:text-gray-400\">Genera enlaces públicos para compartir estadísticas con otros.</p></div></div></div></div></div></div></div><div class=\"rounded-lg border bg-card text-card-foreground shadow-sm mb-8\"><div class=\"flex flex-col space-y-1.5 p-6\"><h3 class=\"font-semibold tracking-tight flex items-center gap-2 text-2xl\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big h-6 w-6 text-green-600\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path><path d=\"m9 11 3 3L22 4\"></path></svg>Consejos y Mejores Prácticas</h3></div><div class=\"p-6 pt-0 space-y-6\"><div class=\"grid md:grid-cols-2 gap-8\"><div><h3 class=\"text-lg font-semibold mb-4\">Para Profesores</h3><ul class=\"space-y-3 text-gray-700 dark:text-gray-300\"><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 text-blue-600 mt-0.5 flex-shrink-0\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg><span class=\"text-sm\">Sube la lista de estudiantes antes de crear evaluaciones</span></li><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 text-blue-600 mt-0.5 flex-shrink-0\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg><span class=\"text-sm\">Usa preguntas claras y específicas</span></li><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 text-blue-600 mt-0.5 flex-shrink-0\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg><span class=\"text-sm\">Revisa las estadísticas para identificar problemas</span></li><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 text-blue-600 mt-0.5 flex-shrink-0\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg><span class=\"text-sm\">Comparte enlaces de estadísticas con los estudiantes</span></li></ul></div><div><h3 class=\"text-lg font-semibold mb-4\">Para Estudiantes</h3><ul class=\"space-y-3 text-gray-700 dark:text-gray-300\"><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 text-green-600 mt-0.5 flex-shrink-0\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg><span class=\"text-sm\">Lee cuidadosamente las instrucciones</span></li><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 text-green-600 mt-0.5 flex-shrink-0\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg><span class=\"text-sm\">Responde de manera honesta y constructiva</span></li><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 text-green-600 mt-0.5 flex-shrink-0\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg><span class=\"text-sm\">Completa todas las preguntas requeridas</span></li><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 text-green-600 mt-0.5 flex-shrink-0\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg><span class=\"text-sm\">Revisa tus respuestas antes de enviar</span></li></ul></div></div></div></div><div class=\"rounded-lg border bg-card text-card-foreground shadow-sm mb-8\"><div class=\"flex flex-col space-y-1.5 p-6\"><h3 class=\"font-semibold tracking-tight flex items-center gap-2 text-2xl\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users h-6 w-6 text-green-600\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"></path></svg>Instrucciones Específicas por Rol</h3></div><div class=\"p-6 pt-0\"><p class=\"text-gray-700 dark:text-gray-300 mb-6\">Accede a guías detalladas específicas para tu rol en la plataforma:</p><div class=\"grid md:grid-cols-2 gap-6\"><div class=\"rounded-lg border text-card-foreground shadow-sm border-green-200 bg-green-50 dark:bg-green-950/20\"><div class=\"p-6 pt-6\"><div class=\"text-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users h-12 w-12 text-green-600 mx-auto mb-4\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"></path></svg><h3 class=\"text-lg font-semibold text-green-800 dark:text-green-300 mb-2\">Para Estudiantes</h3><p class=\"text-sm text-green-700 dark:text-green-200 mb-4\">Aprende cómo participar en evaluaciones y coevaluaciones de manera efectiva</p><a class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2 w-full\" href=\"/instrucciones/estudiante\">Ver Guía de Estudiante</a></div></div></div><div class=\"rounded-lg border text-card-foreground shadow-sm border-blue-200 bg-blue-50 dark:bg-blue-950/20\"><div class=\"p-6 pt-6\"><div class=\"text-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open h-12 w-12 text-blue-600 mx-auto mb-4\"><path d=\"M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z\"></path><path d=\"M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z\"></path></svg><h3 class=\"text-lg font-semibold text-blue-800 dark:text-blue-300 mb-2\">Para Profesores</h3><p class=\"text-sm text-blue-700 dark:text-blue-200 mb-4\">Aprende a gestionar cursos, estudiantes y evaluaciones de manera eficiente</p><a class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2 w-full\" href=\"/instrucciones/profesor\">Ver Guía de Profesor</a></div></div></div></div></div></div><div class=\"rounded-lg border bg-card text-card-foreground shadow-sm mb-8\"><div class=\"flex flex-col space-y-1.5 p-6\"><h3 class=\"font-semibold tracking-tight flex items-center gap-2 text-2xl\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-info h-6 w-6 text-blue-600\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 16v-4\"></path><path d=\"M12 8h.01\"></path></svg>Soporte y Contacto</h3></div><div class=\"p-6 pt-0\"><p class=\"text-gray-700 dark:text-gray-300 mb-4\">Si tienes preguntas o necesitas ayuda con <!-- -->Loopaas<!-- -->, no dudes en contactar al equipo de desarrollo.</p><div class=\"flex flex-wrap gap-4\"><a class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2\" href=\"/cursos\">Ir a Cursos</a><a class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2\" href=\"/login\">Iniciar Sesión</a></div></div></div></div></div><!--$--><!--/$--></div><div role=\"region\" aria-label=\"Notifications (F8)\" tabindex=\"-1\" style=\"pointer-events:none\"><ol tabindex=\"-1\" class=\"fixed top-[80%] z-[100] left-0 md:left-[40%] flex max-h-screen w-full flex-col-reverse p-4 sm:bottom-0 sm:right-0 sm:top-auto sm:flex-col md:max-w-[420px]\"></ol></div><footer class=\"w-full border-t border-t-foreground/10 p-8 flex flex-col gap-4 justify-center text-ce