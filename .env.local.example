# Neon (Postgres)
# Get from: https://neon.tech -> Project Settings -> Connection Details
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# NextAuth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-generated-secret-here
AUTH_URL=http://localhost:3000

# NextAuth Google OAuth (optional)
# Get from: https://console.cloud.google.com -> APIs -> Credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# NextAuth GitHub OAuth (optional)
# Get from: https://github.com/settings/developers -> OAuth Apps
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PASSWORD=your-app-password
NEXT_CANVAS_API_TOKEN=

# Stripe (optional)
NEXT_STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
